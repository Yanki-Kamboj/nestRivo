
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Your Home</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-100 min-h-screen">

    <%- include('../partials/nav') %>

    <div class="flex justify-center px-4 py-10">
        <div class="bg-white p-8 rounded-2xl shadow-lg w-full max-w-lg">

            <h1 class="text-3xl font-bold text-center text-rose-500 mb-2">
                Register Your Home
            </h1>

            <p class="text-gray-500 text-center mb-8">
                Share your space with travelers around the world.
            </p>

            <form action="/host/register" method="POST"
                  enctype="multipart/form-data" class="space-y-5">

                <!-- House Name -->
                <div>
                    <label for="houseName" class="block text-gray-700 font-medium mb-2">
                        House Name
                    </label>
                    <input
                        type="text"
                        id="houseName"
                        name="houseName"
                        placeholder="Enter your house name"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500"
                    >
                </div>

                <!-- Price per Night -->
                <div>
                    <label for="price" class="block text-gray-700 font-medium mb-2">
                        Price per Night (₹)
                    </label>
                    <input
                        type="number"
                        id="price"
                        name="price"
                        placeholder="Enter price per night"
                        min="1"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500"
                    >
                </div>

                <!-- Location -->
                <div>
                    <label for="location" class="block text-gray-700 font-medium mb-2">
                        Location
                    </label>
                    <input
                        type="text"
                        id="location"
                        name="location"
                        placeholder="Enter city or full address"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500"
                    >
                </div>

                <!-- Rating -->
                <div>
                    <label for="rating" class="block text-gray-700 font-medium mb-2">
                        Rating (out of 5)
                    </label>
                    <input
                        type="number"
                        id="rating"
                        name="rating"
                        placeholder="e.g. 4.5"
                        min="0"
                        max="5"
                        step="0.1"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500"
                    >
                </div>

                <!-- Photo -->
                <div>
                    <label for="photo" class="block text-gray-700 font-medium mb-2">
                        House Photo
                    </label>
                    <input
                        type="file"
                        id="photo"
                        name="photo"
                        accept="image/*"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-rose-100 file:text-rose-600 hover:file:bg-rose-200"
                    >
                </div>

                <!-- Submit Button -->
                <button
                    type="submit"
                    class="w-full bg-rose-500 text-white py-3 rounded-lg font-semibold hover:bg-rose-600 transition duration-300 shadow-md"
                >
                    Register Your Home
                </button>

            </form>
        </div>
    </div>

</body>
</html>
