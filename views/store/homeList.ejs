
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Available Homes</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-gray-100 pt-20">
    <%- include('../partials/nav') %>

    <main class="max-w-7xl mx-auto px-6 py-10">
        <header class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Available homes</h1>
            <p class="mt-2 text-gray-600">Find a place for your next stay.</p>
        </header>

        <% if (!homes || homes.length === 0) { %>
            <div class="rounded-xl bg-white p-8 text-center shadow-sm">
                <h2 class="text-xl font-semibold text-gray-800">No homes listed yet</h2>
                <p class="mt-2 text-gray-600">New homes will appear here.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                <% homes.forEach(home => { %>
                    <article class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-md transition hover:shadow-xl">
                        <% if (home.photo) { %>
                            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="h-56 w-full object-cover">
                        <% } else { %>
                            <div class="flex h-56 w-full items-center justify-center bg-gray-200 text-gray-500">No image available</div>
                        <% } %>

                        <div class="flex flex-1 flex-col p-5">
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="text-xl font-semibold text-gray-900"><%= home.houseName %></h2>
                                <span class="whitespace-nowrap text-sm text-gray-700">★ <%= home.rating %></span>
                            </div>
                            <p class="mt-2 text-gray-600"><%= home.location %></p>
                            <p class="mt-4 text-lg font-semibold text-gray-900">₹<%= home.price %> <span class="text-sm font-normal text-gray-500">/ night</span></p>

                            <div class="mt-auto flex gap-3 pt-5">
                                <form action="/favorites" method="POST" class="flex-1">
                                    <input type="hidden" name="id" value="<%= home.id %>">
                                    <button type="submit" class="w-full rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-700">Add to favorites</button>
                                </form>
                                <a href="/home/<%= home.id %>" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-center text-sm font-semibold text-gray-800 hover:bg-gray-50">View details</a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </main>
</body>
</html>
