# Environment variables for NESTRIVO backend

# Required
MONGODB_URI=mongodb://localhost:27017/nestrivo   # MongoDB connection string
CLIENT_URL=http://localhost:5173               # Frontend URL for CORS
JWT_SECRET=your_jwt_secret_here                # Secret for signing JWTs
PORT=5000                                      # Server port (default 5000)

# Optional (provide defaults in code if not set)
NODE_ENV=development
# Add other variables as needed by later phases (e.g., EMAIL_HOST, CLOUDINARY_URL, etc.)
